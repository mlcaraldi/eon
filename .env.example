# Copy to .env for LOCAL DEVELOPMENT only. Production values live in the
# host's environment settings, never in a committed file.
#
# Rules (AGENTS.md "Env vars and secrets"):
# - every variable is documented here: what it is, where it comes from,
#   required or optional;
# - secrets are server-side only, never NEXT_PUBLIC_;
# - development and production get different values, never shared;
# - optional integrations work without their variables and say what's missing.

# --- Database (Neon Postgres, D8) ---
# Added to the Vercel project by the Neon integration (one branch per preview).
# Locally: a Neon dev branch, never the production database.
# Without it: the app runs and says the database is not configured.
DATABASE_URL=

# --- Sign-in (Neon Auth, email code, one allow-listed account, D11) ---
# Neon Console > your project > Auth: enable it, turn on Email OTP, copy the Auth URL.
# Without the three below: sign-in is off and the screen names what is missing.
NEON_AUTH_BASE_URL=
# Random secret, at least 32 characters: openssl rand -base64 32
# Different value for development, preview and production.
NEON_AUTH_COOKIE_SECRET=
# The one email allowed in. It must be verified by the emailed code.
# Anyone else sees "This account is not invited."
EON_ALLOWED_EMAIL=

# --- Open Finance via Pluggy / MeuPluggy (D9) ---
# From the Pluggy developer application (read-only).
# Without them: sync says Open Finance is not configured.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# --- Daily sync (Vercel cron) ---
# Any random string, at least 16 characters. Vercel sends it as a Bearer token
# to the cron route. Without it: the daily sync route refuses to run.
CRON_SECRET=
